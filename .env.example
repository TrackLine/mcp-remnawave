REMNAWAVE_BASE_URL=https://vpn.example.com
REMNAWAVE_API_TOKEN=your-api-token-here

# Optional: Remnawave API release. Defaults to v3; set v2 for Remnawave 2.7.4.
# REMNAWAVE_RELEASE=v3

# Optional: outgoing Remnawave API request timeout in milliseconds (default: 30000)
# REMNAWAVE_REQUEST_TIMEOUT_MS=30000

# Optional: API key for Caddy reverse proxy with custom path
# See: https://docs.remnawave.com/docs/security/caddy-with-custom-path/
# REMNAWAVE_API_KEY=your-caddy-api-key

# Optional: Cloudflare Access service token for a protected panel
# CF_ACCESS_CLIENT_ID=your-client-id
# CF_ACCESS_CLIENT_SECRET=your-client-secret

# Optional: enable readonly mode (only read/list operations, no create/update/delete)
# REMNAWAVE_READONLY=true

# Optional: serve MCP over Streamable HTTP as well as stdio
# MCP_HTTP_ENABLED=true
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=3100
